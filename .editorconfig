# Editor configuration for koko.
# Baseline adapted from:
# /home/rbright/Projects/4pillarfunding/platform/.editorconfig

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4
max_line_length = 120

# Markdown files
[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

# JSON files
[*.json]
indent_size = 2
max_line_length = 80

# TOML files
[*.toml]
indent_size = 2
max_line_length = 80

# YAML files
[*.{yml,yaml}]
indent_size = 2
max_line_length = 80

# Nix files
[*.nix]
indent_size = 2
max_line_length = 100

# Shell scripts
[*.sh]
indent_size = 2
max_line_length = 80

# Justfile
[justfile,*.just]
indent_size = 2
max_line_length = 80
